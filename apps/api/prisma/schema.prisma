generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(uuid())
  username            String               @unique
  displayName         String
  avatarUrl           String?
  email               String               @unique
  countryCode         String?
  bio                 String?
  status              Status               @default(ACTIVE)
  role                Role                 @default(USER)
  isVerified          Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?
  accounts            Account[]
  passwordResetTokens PasswordResetToken[]
  player              Player?
  sessions            Session[]
  verificationTokens  VerificationToken[]
}

model Account {
  id            String       @id @default(uuid())
  userId        String
  provider      AuthProvider
  providerId    String?
  providerEmail String?
  passwordHash  String?
  lastLoginAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions      Session[]

  @@unique([provider, providerId])
  @@index([userId])
}

model Session {
  id               String                   @id @default(uuid())
  userId           String
  accountId        String?
  refreshTokenHash String
  expiresAt        DateTime
  lastSeenAt       DateTime?
  ipAddress        String?
  userAgent        String?
  deviceName       String?
  revokedAt        DateTime?
  revokedReason    SessionRevocationReason?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  account          Account?                 @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user             User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([accountId])
  @@index([revokedAt])
  @@index([expiresAt])
}

model VerificationToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Player {
  id                 String              @id @default(uuid())
  userId             String              @unique
  title              PlayerTitle         @default(NONE)
  fairPlayScore      Int                 @default(100)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  blackGames         Game[]              @relation("GameBlack")
  whiteGames         Game[]              @relation("GameWhite")
  wonGames           Game[]              @relation("GameWinner")
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  playerAchievements PlayerAchievement[]
  ratings            Rating[]

  @@index([userId])
}

model Achievement {
  id                 String              @id @default(uuid())
  code               String              @unique
  name               String
  description        String?
  type               AchievementType     @default(GAMEPLAY)
  iconUrl            String?
  createdAt          DateTime            @default(now())
  playerAchievements PlayerAchievement[]
}

model PlayerAchievement {
  id            String      @id @default(uuid())
  playerId      String
  achievementId String
  unlockedAt    DateTime?
  progress      Int         @default(0)
  createdAt     DateTime    @default(now())
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  player        Player      @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, achievementId])
  @@index([playerId])
  @@index([achievementId])
}

model Rating {
  id              String          @id @default(uuid())
  playerId        String
  type            RatingType
  currentRating   Int             @default(1200)
  peakRating      Int             @default(1200)
  gamesPlayed     Int             @default(0)
  wins            Int             @default(0)
  losses          Int             @default(0)
  draws           Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  lastPlayedAt    DateTime?
  ratingDeviation Float?
  volatility      Float?
  player          Player          @relation(fields: [playerId], references: [id], onDelete: Cascade)
  history         RatingHistory[]

  @@unique([playerId, type])
  @@index([playerId])
}

model RatingHistory {
  id           String                  @id @default(uuid())
  ratingId     String
  sourceType   RatingHistorySourceType
  sourceId     String?
  oldRating    Int
  newRating    Int
  ratingChange Int
  createdAt    DateTime                @default(now())
  rating       Rating                  @relation(fields: [ratingId], references: [id], onDelete: Cascade)

  @@index([ratingId])
  @@index([createdAt])
}

model Game {
  id             String      @id @default(uuid())
  whitePlayerId  String
  blackPlayerId  String
  winnerPlayerId String?
  result         GameResult?
  status         GameStatus  @default(WAITING)
  timeControl    String?
  opening        String?
  initialFen     String?
  finalFen       String?
  movesCount     Int         @default(0)
  startedAt      DateTime?
  endedAt        DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  blackPlayer    Player      @relation("GameBlack", fields: [blackPlayerId], references: [id], onDelete: Cascade)
  whitePlayer    Player      @relation("GameWhite", fields: [whitePlayerId], references: [id], onDelete: Cascade)
  winner         Player?     @relation("GameWinner", fields: [winnerPlayerId], references: [id])

  @@index([whitePlayerId])
  @@index([blackPlayerId])
  @@index([winnerPlayerId])
  @@index([status])
  @@index([result])
  @@index([startedAt])
}

enum Status {
  ACTIVE
  SUSPENDED
  BANNED
  DELETED
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

enum AchievementType {
  GAMEPLAY
  RATING
  PUZZLE
  TOURNAMENT
  SOCIAL
}

enum PlayerTitle {
  NONE
  GM
  IM
  FM
  CM
  NM
}

enum RatingType {
  BULLET
  BLITZ
  RAPID
  CLASSICAL
  PUZZLE
}

enum RatingHistorySourceType {
  GAME
  PUZZLE
  TOURNAMENT
  ADMIN_ADJUSTMENT
}

enum GameResult {
  WHITE_WIN
  BLACK_WIN
  DRAW
  ABANDONED
}

enum GameStatus {
  WAITING
  ACTIVE
  FINISHED
  ABORTED
}

enum SessionRevocationReason {
  LOGOUT
  LOGOUT_ALL
  PASSWORD_CHANGE
  ACCOUNT_BANNED
  SECURITY_EVENT
}

enum AuthProvider {
  LOCAL
  GOOGLE
  APPLE
  GITHUB
  DISCORD
}
